# Database Configuration
# Optional: Set DATABASE_URL for persistent statistics
# If not set, the game will use in-memory storage (statistics won't persist after restart)

# For local development with PostgreSQL:
# DATABASE_URL=postgresql://localhost:5432/bang

# For Railway deployment (auto-set by Railway):
# DATABASE_URL=postgresql://user:password@host:port/database

# To set up local PostgreSQL:
# 1. Install PostgreSQL
# 2. Create a database: createdb bang
# 3. Uncomment and set DATABASE_URL above
