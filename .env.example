# Database Configuration
# PostgreSQL is required for both local development and Railway deployment
# Set DATABASE_URL to your PostgreSQL connection string
DATABASE_URL=postgresql://localhost:5432/bang

# Example Railway DATABASE_URL (auto-set by Railway):
# DATABASE_URL=postgresql://user:password@host:port/database

# For local development, you need to set up a local PostgreSQL database:
# 1. Install PostgreSQL
# 2. Create a database: createdb bang
# 3. Set DATABASE_URL as shown above
